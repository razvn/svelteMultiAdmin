		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.0.0",
		"vitest": "^5.0.5",
		"zod": "^4.0.0"
